{
  "name": "sidekick-extension",
  "description": "翻翻 Sidekick – AI side panel for bilingual web translation and page summaries (BYOK)",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "build:e2e": "SIDEKICK_E2E=1 wxt build",
    "test:e2e": "npm run build:e2e && playwright test",
    "check:permissions": "node scripts/check-permissions.mjs",
    "screenshots": "npm run build:e2e && playwright test -c playwright.shots.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
